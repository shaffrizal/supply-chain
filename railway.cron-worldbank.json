{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "php artisan migrate --force --no-interaction"
    ],
    "startCommand": "php artisan worldbank:sync --no-interaction",
    "cronSchedule": "0 19 * * *",
    "restartPolicyType": "NEVER"
  }
}
